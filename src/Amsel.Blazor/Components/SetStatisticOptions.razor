<label for="sort">
    Sort order
</label>
<div id="sort">
    <select @onchange="SortChanged" value="@Options.Sort">
        <option value=@Sort.ReleaseDate>Release Date</option>
        <option value=@Sort.Name>Name</option>
        <option value=@Sort.SetCode>Set Code</option>
        <option value=@Sort.Completion1x>1x Completion</option>
        <option value=@Sort.Completion4x>4x Completion</option>
    </select>
    <select @onchange="DirectionChanged" value="@Options.SortDirection">
        <option value=@SortDirection.Ascending>Ascending</option>
        <option value=@SortDirection.Descending>Descending</option>
    </select>
</div>
<label for="filter">Filter</label>
<div id="filter">
    <div>
        <input type="checkbox" id="withNoMetadata" @onchange="WithNoMetadataChanged"
               checked="@Options.Filter.WithNoMetadata" />
        <label for="withNoMetadata">Include sets without metadata</label>
    </div>
    <div>
        <input type="checkbox" id="withNoName" @onchange="WithNoNameChanged" checked="@Options.Filter.WithNoName"
               disabled="@(!Options.Filter.WithNoMetadata)" />
        <label for="withNoName">Include sets without name</label>
    </div>
    <div>
        <input type="checkbox" id="withNoProgress" @onchange="WithNoProgressChanged"
               checked="@Options.Filter.WithNoProgress" />
        <label for="withNoProgress">Include sets without progress</label>
    </div>
    <div>
        <input type="checkbox" id="withSubsets" @onchange="WithSubsetsChanged" checked="@Options.Filter.WithSubsets" />
        <label for="withSubsets">Include subsets</label>
    </div>
</div>

@code {


    public readonly record struct Values(Filter Filter, Sort Sort, SortDirection SortDirection);
    public readonly record struct Filter(bool WithNoMetadata, bool WithNoName, bool WithNoProgress, bool WithSubsets);

    public enum Sort
    {
        Name,
        SetCode,
        ReleaseDate,
        Completion1x,
        Completion4x
    }

    public enum SortDirection
    {
        Ascending,
        Descending
    }

    [Parameter]
    public EventCallback<Values> OptionsChanged { get; set; }

    [Parameter]
    public Values Options { get; set; }

    private void SortChanged(ChangeEventArgs e)
    {
        if (e.Value == null)
            return;
        Options = Options with { Sort = Enum.Parse<Sort>((string)e.Value) };
        OptionsChanged.InvokeAsync(Options);
    }

    private void DirectionChanged(ChangeEventArgs e)
    {
        if (e.Value == null)
            return;
        Options = Options with { SortDirection = Enum.Parse<SortDirection>((string)e.Value) };
        OptionsChanged.InvokeAsync(Options);
    }

    private void WithNoMetadataChanged(ChangeEventArgs e)
    {
        if (e.Value == null)
            return;
        Options = Options with { Filter = Options.Filter with { WithNoMetadata = (bool)e.Value } };
        OptionsChanged.InvokeAsync(Options);
    }

    private void WithNoNameChanged(ChangeEventArgs e)
    {
        if (e.Value == null)
            return;
        Options = Options with { Filter = Options.Filter with { WithNoName = (bool)e.Value } };
        OptionsChanged.InvokeAsync(Options);
    }

    private void WithNoProgressChanged(ChangeEventArgs e)
    {
        if (e.Value == null)
            return;
        Options = Options with { Filter = Options.Filter with { WithNoProgress = (bool)e.Value } };
        OptionsChanged.InvokeAsync(Options);
    }

    private void WithSubsetsChanged(ChangeEventArgs e)
    {
        if (e.Value == null)
            return;
        Options = Options with { Filter = Options.Filter with { WithSubsets = (bool)e.Value } };
        OptionsChanged.InvokeAsync(Options);
    }
}
