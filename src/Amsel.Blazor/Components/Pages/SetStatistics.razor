@page "/set-statistics"
@rendermode InteractiveServer

@using Amsel.Data;

@inject ArenaState state


@if (error)
{
    <h1>Set statistics could not be loaded!</h1>
}
else if (loading)
{
    <h1>Loading...</h1>
}
else
{
    <div class="set-statistics">
        @foreach (var set in state.SetStatistics.Values)
        {
            <div class="set-statistic @(set.IsDigitalSet ? "digital-set" : "regular-set")">
                @if (state.SetLocalization.TryGetValue(set.SetCode, out string? name) && !string.IsNullOrWhiteSpace(name))
                {
                    <div>
                        @name
                    </div>
                }
                <div>
                    @set.SetCode
                </div>
                @if (state.SetMetadata.TryGetValue(set.SetCode, out SetMetadata? meta) && meta != null)
                {
                    <div>
                        @meta.ReleaseDate.ToShortDateString()
                    </div>
                    <div>
                        @AvailabilityStringToString(meta.Availability)
                    </div>
                }
                <div>
                    @SetTotalString(set)
                </div>
                <div>
                    @SetUniqueString(set)
                </div>
            </div>
        }
    </div>
}

@code {
    private bool error = false;
    private bool loading = true;

    protected async override Task OnInitializedAsync()
    {
        try
        {
            await state.LoadCardInfoAsync();
            loading = false;
        }
        catch (Exception e)
        {
            Console.WriteLine(e.ToString());
            error = true;
        }
    }

    private static string AvailabilityStringToString(Availability a)
    {
        return a switch
        {
            Availability.AlchemyNotStandard => "Alchemy",
            Availability.Available => "Standard + Alchemy",
            Availability.EternalOnly => "Eternal",
            Availability.HistoricOnly => "Historic",
            Availability.RotatingOutSoonAlchemy => "Rotating out of Alchemy",
            Availability.RotatingOutSoonStandard => "Rotating out of Standard",
            Availability.StandardNotAlchemy => "Standard",
            _ => ""
        };
    }

    private static string SetUniqueString(SetStatistic set)
    {
        double percent = 100.0 * set.TotalOwnedUnique / set.CardCount;
        return
            $"""
            1x: {set.TotalOwnedUnique} / {set.CardCount}
            ({percent.ToString("0.#")} %)
            """;
    }

    private static string SetTotalString(SetStatistic set)
    {
        double percent = 25.0 * set.TotalOwned / set.CardCount;
        return
            $"""
            4x: {set.TotalOwned} / {set.CardCount * 4}
            ({percent.ToString("0.#")} %)
            """;
    }
}
