@page "/set-statistics"
@rendermode InteractiveServer

@using Amsel.Data;

@inject ArenaState state


@if (error)
{
    <h1>Set statistics could not be loaded!</h1>
}
else if (loading)
{
    <h1>Loading...</h1>
}
else
{
    <div class="set-statistic-options">
        <SetStatisticOptions @bind-Options="options" />
    </div>

    <div class="set-statistics">
        @foreach (var set in SortAndFilterSets())
        {
            <div class="set-statistic @GetExtraCssForStatistic(set)">
                @if (!string.IsNullOrWhiteSpace(set.Name))
                {
                    <div>
                        @set.Name
                    </div>
                }
                <div>
                    @set.Code
                </div>
                @if (set.Metadata != null)
                {
                    <div>
                        @set.Metadata.ReleaseDate.ToShortDateString()
                    </div>
                    <div>
                        @AvailabilityStringToString(set.Metadata.Availability)
                    </div>
                }
                <div>
                    @SetTotalString(set.Statistic)
                </div>
                <div>
                    @SetUniqueString(set.Statistic)
                </div>
            </div>
        }
    </div>
}

@code {
    private bool error = false;
    private bool loading = true;
    private SetStatisticOptions.Values options = new SetStatisticOptions.Values(
        new SetStatisticOptions.Filter(false, false, false, true),
        SetStatisticOptions.Sort.ReleaseDate,
        SetStatisticOptions.SortDirection.Descending);

    private static IComparable GetValueBySort(SetInformation s, SetStatisticOptions.Sort sort)
    {
        return sort switch
        {
            SetStatisticOptions.Sort.Name => s.Name ?? "",
            SetStatisticOptions.Sort.SetCode => s.Code,
            SetStatisticOptions.Sort.ReleaseDate => s.Metadata?.ReleaseDate ?? default(DateTime),
            SetStatisticOptions.Sort.Completion1x => s.Statistic.PercentOwnedUnique,
            SetStatisticOptions.Sort.Completion4x => s.Statistic.PercentOwned,
            _ => throw new ArgumentException("Unknown Sort mode")
        };
    }

    private IEnumerable<SetInformation> SortAndFilterSets()
    {
        var result = state.SetInformation.Select(e => e.Value);
        if (options.SortDirection == SetStatisticOptions.SortDirection.Ascending)
        {
            result = result.OrderBy(s => GetValueBySort(s, options.Sort));
        }
        else
        {
            result = result.OrderByDescending(s => GetValueBySort(s, options.Sort));
        }

        result = result.Where(s =>
        {
            if (!options.Filter.WithNoMetadata && s.Metadata == null)
                return false;

            if (!options.Filter.WithNoName && s.Name == null)
                return false;

            if (!options.Filter.WithNoProgress && s.Statistic.TotalOwned == 0)
                return false;

            if (!options.Filter.WithSubsets && s.Metadata?.ParentCode != null)
                return false;
            return true;
        });

        return result;
    }

    protected async override Task OnInitializedAsync()
    {
        try
        {
            await state.LoadCardInfoAsync();
            loading = false;
        }
        catch (Exception e)
        {
            Console.WriteLine(e.ToString());
            error = true;
        }
    }

    private static string AvailabilityStringToString(Availability a)
    {
        return a switch
        {
            Availability.AlchemyNotStandard => "Alchemy",
            Availability.Available => "Standard + Alchemy",
            Availability.EternalOnly => "Eternal",
            Availability.HistoricOnly => "Historic",
            Availability.RotatingOutSoonAlchemy => "Rotating out of Alchemy",
            Availability.RotatingOutSoonStandard => "Rotating out of Standard",
            Availability.StandardNotAlchemy => "Standard",
            _ => ""
        };
    }

    private static string SetUniqueString(SetStatistic set)
    {
        return
            $"""
            1x: {set.TotalOwnedUnique} / {set.CardCount}
            ({set.PercentOwnedUnique.ToString("0.#")} %)
            """;
    }

    private static string SetTotalString(SetStatistic set)
    {
        return
            $"""
            4x: {set.TotalOwned} / {set.CardCount * 4}
            ({set.PercentOwned.ToString("0.#")} %)
            """;
    }

    private string GetExtraCssForStatistic(SetInformation set)
    {
        List<string> list = [];
        if (set.Metadata == null)
        {
            list.Add(set.Name != null ? "only-name-set" : "no-metadata-set");
        }
        else
        {
            list.Add(set.Metadata.ParentCode != null ? "sub-set" : "major-set");
        }

        if (set.Statistic.TotalOwned == set.Statistic.CardCount * 4)
        {
            list.Add("complete-4x");
        }
        else if (set.Statistic.TotalOwnedUnique == set.Statistic.CardCount)
        {
            list.Add("complete-1x");
        }

        return string.Join(' ', list);
    }
}
