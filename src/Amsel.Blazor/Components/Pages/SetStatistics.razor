@page "/set-statistics"
@rendermode InteractiveServer

@using Amsel.Data;

@inject ArenaState state


@if (error)
{
    <h1>Set statistics could not be loaded!</h1>
}
else if (loading)
{
    <h1>Loading...</h1>
}
else
{
    <div class="set-statistic-options">
        <SetStatisticOptions @bind-Options="options" @bind-Options:after="OnOptionsChanged" />
    </div>

    <div class="set-statistics">
        @foreach (var set in SortAndFilterSets())
        {
            <div class="set-statistic @GetExtraCssForStatistic(set)">
                @if (!string.IsNullOrWhiteSpace(set.Name))
                {
                    <div>
                        @set.Name
                    </div>
                }
                <div>
                    @set.Code
                </div>
                @if (set.Metadata != null)
                {
                    <div>
                        @set.Metadata.ReleaseDate.ToShortDateString()
                    </div>
                    <div>
                        @AvailabilityStringToString(set.Metadata.Availability)
                    </div>
                }
                <div>
                    @SetTotalString(set.Statistic)
                </div>
                <div>
                    @SetUniqueString(set.Statistic)
                </div>
            </div>
        }
    </div>
}

@code {
    private bool error = false;
    private bool loading = true;
    private SetStatisticOptions.Values options;

    private IEnumerable<SetInformation> SortAndFilterSets()
    {
        // TODO
        return state.SetInformation.Select(e => e.Value);
    }

    protected async override Task OnInitializedAsync()
    {
        try
        {
            await state.LoadCardInfoAsync();
            loading = false;
        }
        catch (Exception e)
        {
            Console.WriteLine(e.ToString());
            error = true;
        }
    }

    private static string AvailabilityStringToString(Availability a)
    {
        return a switch
        {
            Availability.AlchemyNotStandard => "Alchemy",
            Availability.Available => "Standard + Alchemy",
            Availability.EternalOnly => "Eternal",
            Availability.HistoricOnly => "Historic",
            Availability.RotatingOutSoonAlchemy => "Rotating out of Alchemy",
            Availability.RotatingOutSoonStandard => "Rotating out of Standard",
            Availability.StandardNotAlchemy => "Standard",
            _ => ""
        };
    }

    private static string SetUniqueString(SetStatistic set)
    {
        double percent = 100.0 * set.TotalOwnedUnique / set.CardCount;
        return
            $"""
            1x: {set.TotalOwnedUnique} / {set.CardCount}
            ({percent.ToString("0.#")} %)
            """;
    }

    private static string SetTotalString(SetStatistic set)
    {
        double percent = 25.0 * set.TotalOwned / set.CardCount;
        return
            $"""
            4x: {set.TotalOwned} / {set.CardCount * 4}
            ({percent.ToString("0.#")} %)
            """;
    }

    private void OnOptionsChanged()
    {
        Console.WriteLine($"Options Changed {options}");
    }

    private string GetExtraCssForStatistic(SetInformation set)
    {
        List<string> list = [];
        if (set.Metadata == null)
        {
            list.Add(set.Name != null ? "only-name-set" : "no-metadata-set");
        }
        else
        {
            list.Add(set.Metadata.ParentCode != null ? "sub-set" : "major-set");
        }

        if (set.Statistic.TotalOwned == set.Statistic.CardCount * 4)
        {
            list.Add("complete-4x");
        }
        else if (set.Statistic.TotalOwnedUnique == set.Statistic.CardCount)
        {
            list.Add("complete-1x");
        }

        return string.Join(' ', list);
    }
}
