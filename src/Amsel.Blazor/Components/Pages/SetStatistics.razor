@page "/set-statistics"
@rendermode InteractiveServer

@inject ArenaState state

@if (error)
{
    <h1>Set statistics could not be loaded!</h1>
}
else if (loading)
{
    <h1>Loading...</h1>
}
else
{
    <div class="set-statistic-options">
        <SetStatisticOptions @bind-Options="options" />
    </div>

    <div class="set-statistics">
        @foreach (var set in SortAndFilterSets())
        {
            <SetStatisticTile SetInformation="set" Clicked="SelectSet" Selected=@(selectedSet?.Code == set.Code) />
        }
    </div>
}

@code {
    private bool error = false;
    private bool loading = true;
    private SetStatisticOptions.Values options = new SetStatisticOptions.Values(
        new SetStatisticOptions.Filter(false, false, false, true),
        SetStatisticOptions.Sort.ReleaseDate,
        SetStatisticOptions.SortDirection.Descending);
    private SetInformation? selectedSet;

    private static IComparable GetValueBySort(SetInformation s, SetStatisticOptions.Sort sort)
    {
        return sort switch
        {
            SetStatisticOptions.Sort.Name => s.Name ?? "",
            SetStatisticOptions.Sort.SetCode => s.Code,
            SetStatisticOptions.Sort.ReleaseDate => s.Metadata?.ReleaseDate ?? default(DateTime),
            SetStatisticOptions.Sort.Completion1x => s.Statistic.PercentOwnedUnique,
            SetStatisticOptions.Sort.Completion4x => s.Statistic.PercentOwned,
            _ => throw new ArgumentException("Unknown Sort mode")
        };
    }

    private IEnumerable<SetInformation> SortAndFilterSets()
    {
        var result = state.SetInformation.Select(e => e.Value);
        if (options.SortDirection == SetStatisticOptions.SortDirection.Ascending)
        {
            result = result.OrderBy(s => GetValueBySort(s, options.Sort));
        }
        else
        {
            result = result.OrderByDescending(s => GetValueBySort(s, options.Sort));
        }

        result = result.Where(s =>
        {
            if (!options.Filter.WithNoMetadata && s.Metadata == null)
                return false;

            if (!options.Filter.WithNoName && s.Name == null)
                return false;

            if (!options.Filter.WithNoProgress && s.Statistic.TotalOwned == 0)
                return false;

            if (!options.Filter.WithSubsets && s.Metadata?.ParentCode != null)
                return false;
            return true;
        });

        return result;
    }

    protected async override Task OnInitializedAsync()
    {
        try
        {
            await state.LoadCardInfoAsync();
            loading = false;
        }
        catch (Exception e)
        {
            Console.WriteLine(e.ToString());
            error = true;
        }
    }

    private void SelectSet(SetInformation set)
    {
        selectedSet = set;
    }
}
