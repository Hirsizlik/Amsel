@page "/card-list"
@rendermode InteractiveServer
@inject ArenaState state

@using System.Collections.Frozen;
@using System.Collections.Immutable;

@if (error)
{
    <h1>Card list could not be loaded!</h1>
}
else if (loading)
{
    <h1>Loading...</h1>
}
else
{
    <StringSelect Options="expansionSetCodes" @bind-Value="expansionFilter"
                  @bind-Value:after="OnExpansionCodeFilterChanged" />
    <StringSelect Options="digitalReleaseCodes" @bind-Value="digitalReleaseFilter"
                  @bind-Value:after="OnDigitalReleaseCodeFilterChanged" />
    <table>
        <thead>
            <th>Name</th>
            <th>Set</th>
            <th>Digital Set</th>
            <th>Rarity</th>
            <th>Owned</th>
        </thead>
        <tbody>
            <Virtualize ItemsProvider="@ProvideFilteredCards" Context="card" @ref="CardStatsContainer">
                <tr>
                    <td> @card.Info.Name </td>
                    <td> @card.Info.ExpansionCode </td>
                    <td> @card.Info.DigitalReleaseSet </td>
                    <td> @card.Info.Rarity </td>
                    <td> @card.Owned </td>
                </tr>

            </Virtualize>
        </tbody>
    </table>
}

@code {

    bool error = false;
    bool loading = true;
    private FrozenSet<string> expansionSetCodes = [];
    private FrozenSet<string> digitalReleaseCodes = [];
    private string? expansionFilter;
    private string? digitalReleaseFilter;
    private ImmutableArray<CardStats> filteredCards = [];
    private Virtualize<CardStats>? CardStatsContainer { get; set; }

    protected async override Task OnInitializedAsync()
    {
        try
        {
            await state.LoadCardInfoAsync();
            loading = false;
            expansionSetCodes = state.Cards.Select(c => c.Info.ExpansionCode).ToFrozenSet();
            digitalReleaseCodes = state.Cards
                .Select(c => c.Info.DigitalReleaseSet)
                .Where(s => !string.IsNullOrEmpty(s))
                .ToFrozenSet();
            filteredCards = state.Cards.ToImmutableArray();
        }
        catch (Exception e)
        {
            Console.WriteLine(e.ToString());
            error = true;
        }
    }

    private async Task OnExpansionCodeFilterChanged()
    {
        if (!string.IsNullOrEmpty(expansionFilter)) digitalReleaseFilter = "";
        await SetFilteredCardsAsync();
    }

    private async Task OnDigitalReleaseCodeFilterChanged()
    {
        if (!string.IsNullOrEmpty(digitalReleaseFilter)) expansionFilter = "";
        await SetFilteredCardsAsync();
    }

    private async Task SetFilteredCardsAsync()
    {
        filteredCards = state.Cards.Where(c =>
        {
            if (!string.IsNullOrEmpty(expansionFilter))
            {
                return c.Info.ExpansionCode == expansionFilter;
            }
            else if (!string.IsNullOrEmpty(digitalReleaseFilter))
            {
                return c.Info.DigitalReleaseSet == digitalReleaseFilter;
            }
            else
            {
                return true;
            }
        }).ToImmutableArray();

        if (CardStatsContainer != null)
        {
            await CardStatsContainer.RefreshDataAsync();
        }
        StateHasChanged();
    }

    private ValueTask<ItemsProviderResult<CardStats>> ProvideFilteredCards(ItemsProviderRequest request)
    {
        var numCards = Math.Min(request.Count, filteredCards.Length - request.StartIndex);
        var result = filteredCards.Skip(request.StartIndex).Take(numCards);
        return ValueTask.FromResult(new ItemsProviderResult<CardStats>(result, filteredCards.Length));
    }
}


