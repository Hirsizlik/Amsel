@page "/card-list"
@rendermode InteractiveServer
@inject ArenaState state

@using System.Collections.Immutable;

@if (error)
{
    <h1>Card list could not be loaded!</h1>
}
else if (loading)
{
    <h1>Loading...</h1>
}
else
{
    <StringSelect Options="expansionSetCodes" @bind-Value="expansionFilter"
                  @bind-Value:after="OnExpansionCodeFilterChanged" />
    <StringSelect Options="digitalReleaseCodes" @bind-Value="digitalReleaseFilter"
                  @bind-Value:after="OnDigitalReleaseCodeFilterChanged" />
    <table>
        <thead>
            @foreach (Column c in GetColumns())
            {
                <th @onclick="e => OnSort(c)" class=@GetCssClassForColumn(c)>@GetNameForColumn(c)</th>
            }
        </thead>
        <tbody>
            <Virtualize ItemsProvider="ProvideFilteredCards" Context="card" @ref="CardStatsContainer">
                <tr>
                    @foreach (Column c in GetColumns())
                    {
                        <td> @PickColumnValue(c, card) </td>
                    }
                </tr>
            </Virtualize>
        </tbody>
    </table>
}

@code {

    bool error = false;
    bool loading = true;
    private ImmutableArray<string> expansionSetCodes = [];
    private ImmutableArray<string> digitalReleaseCodes = [];
    private string? expansionFilter;
    private string? digitalReleaseFilter;
    private ImmutableArray<CardStats> filteredCards = [];
    private Virtualize<CardStats>? CardStatsContainer { get; set; }

    private enum Column
    {
        None,
        Name,
        Set,
        DigitalSet,
        Rarity,
        Owned,
    }
    private record Sort(Column column, bool isDesc);
    private Sort sortColumn = new Sort(Column.None, false);


    protected async override Task OnInitializedAsync()
    {
        try
        {
            await state.LoadCardInfoAsync();
            loading = false;
            expansionSetCodes = state.Cards
                .Select(c => c.Info.ExpansionCode)
                .Distinct()
                .OrderBy(s => s)
                .ToImmutableArray();
            digitalReleaseCodes = state.Cards
                .Select(c => c.Info.DigitalReleaseSet)
                .Distinct()
                .Where(s => !string.IsNullOrEmpty(s))
                .OrderBy(s => s)
                .ToImmutableArray();
            filteredCards = state.Cards.ToImmutableArray();
        }
        catch (Exception e)
        {
            Console.WriteLine(e.ToString());
            error = true;
        }
    }

    private async Task OnExpansionCodeFilterChanged()
    {
        if (!string.IsNullOrEmpty(expansionFilter)) digitalReleaseFilter = "";
        await SetFilteredCardsAsync();
    }

    private async Task OnDigitalReleaseCodeFilterChanged()
    {
        if (!string.IsNullOrEmpty(digitalReleaseFilter)) expansionFilter = "";
        await SetFilteredCardsAsync();
    }

    private object PickSortColumnValue(CardStats c)
    {
        return PickColumnValue(sortColumn.column, c);
    }

    private static object PickColumnValue(Column column, CardStats c)
    {
        return column switch
        {
            Column.None => "",
            Column.Name => c.Info.Name,
            Column.Set => c.Info.ExpansionCode,
            Column.DigitalSet => c.Info.DigitalReleaseSet,
            Column.Rarity => c.Info.Rarity,
            Column.Owned => c.Owned,
            _ => throw new ArgumentOutOfRangeException($"Unknown Column {column} picked"),
        };
    }

    private async Task SetFilteredCardsAsync()
    {
        var filteredCardsEnumerable = state.Cards.Where(c =>
        {
            if (!string.IsNullOrEmpty(expansionFilter))
            {
                return c.Info.ExpansionCode == expansionFilter;
            }
            if (!string.IsNullOrEmpty(digitalReleaseFilter))
            {
                return c.Info.DigitalReleaseSet == digitalReleaseFilter;
            }
            return true;

        });
        filteredCardsEnumerable = sortColumn.isDesc ?
            filteredCardsEnumerable.OrderByDescending(PickSortColumnValue) :
            filteredCardsEnumerable.OrderBy(PickSortColumnValue);
        filteredCards = filteredCardsEnumerable.ToImmutableArray();

        if (CardStatsContainer != null)
        {
            await CardStatsContainer.RefreshDataAsync();
        }
        StateHasChanged();
    }

    private ValueTask<ItemsProviderResult<CardStats>> ProvideFilteredCards(ItemsProviderRequest request)
    {
        var numCards = Math.Min(request.Count, filteredCards.Length - request.StartIndex);
        var result = filteredCards.Skip(request.StartIndex).Take(numCards);
        return ValueTask.FromResult(new ItemsProviderResult<CardStats>(result, filteredCards.Length));
    }

    private async Task OnSort(Column column)
    {
        if (sortColumn.column == column)
        {
            if (!sortColumn.isDesc)
            {
                sortColumn = new Sort(column, true);
            }
            else
            {
                sortColumn = new Sort(Column.None, false); // reset
            }
        }
        else
        {
            sortColumn = new Sort(column, false);
        }

        await SetFilteredCardsAsync();
    }

    private string GetCssClassForColumn(Column column)
    {
        if (column == sortColumn.column)
        {
            return sortColumn.isDesc ? "sort-desc" : "sort-asc";
        }
        else
        {
            return "";
        }
    }

    private static string GetNameForColumn(Column column)
    {
        return column switch
        {
            Column.DigitalSet => "Digital Set",
            _ => column.ToString()
        };
    }

    private static IEnumerable<Column> GetColumns()
    {
        return Enum.GetValues<Column>().Skip(1);
    }
}
