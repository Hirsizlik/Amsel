@page "/card-list"
@rendermode InteractiveServer
@inject ArenaState state

@using System.Collections.Frozen;
@using System.Collections.Immutable;
@using ArenaConnect;

@if (error)
{
    <h1>Card list could not be loaded!</h1>
}
else if (loading)
{
    <h1>Loading...</h1>
}
else
{
    <StringSelect Options="expansionSetCodes" @bind-Value="expansionFilter"
                  @bind-Value:after="OnExpansionCodeFilterChanged" />
    <StringSelect Options="digitalReleaseCodes" @bind-Value="digitalReleaseFilter"
                  @bind-Value:after="OnDigitalReleaseCodeFilterChanged" />
    <table>
        <thead>
            <th>Name</th>
            <th>Set</th>
            <th>Digital Set</th>
            <th>Rarity</th>
            <th>Owned</th>
        </thead>
        <tbody>
            <Virtualize ItemsProvider="@ProvideFilteredCards" Context="cardInfo" @ref="CardInfoContainer">
                @{
                    var amount = 0;
                }
                @if (state.CardsOwned.TryGetValue(cardInfo.CardId, out var cardOwned))
                {
                    amount = cardOwned.Amount;
                }
                <tr>
                    <td> @cardInfo.Name </td>
                    <td> @cardInfo.ExpansionCode </td>
                    <td> @cardInfo.DigitalReleaseSet </td>
                    <td> @cardInfo.Rarity </td>
                    <td> @amount </td>
                </tr>

            </Virtualize>
        </tbody>
    </table>
}

@code {

    bool error = false;
    bool loading = true;
    private FrozenSet<string> expansionSetCodes = [];
    private FrozenSet<string> digitalReleaseCodes = [];
    private string? expansionFilter;
    private string? digitalReleaseFilter;
    private ImmutableArray<CardInfo> filteredCards = [];
    private Virtualize<CardInfo>? CardInfoContainer { get; set; }

    protected async override Task OnInitializedAsync()
    {
        try
        {
            await state.LoadCardInfoAsync();
            loading = false;
            expansionSetCodes = state.Cards.Values.Select(c => c.ExpansionCode).ToFrozenSet();
            digitalReleaseCodes = state.Cards.Values
                .Select(c => c.DigitalReleaseSet)
                .Where(s => !string.IsNullOrEmpty(s))
                .ToFrozenSet();
            filteredCards = state.Cards.Values.ToImmutableArray();
        }
        catch (Exception)
        {
            error = true;
        }
    }

    private async Task OnExpansionCodeFilterChanged()
    {
        if (!string.IsNullOrEmpty(expansionFilter)) digitalReleaseFilter = "";
        await SetFilteredCardsAsync();
    }

    private async Task OnDigitalReleaseCodeFilterChanged()
    {
        if (!string.IsNullOrEmpty(digitalReleaseFilter)) expansionFilter = "";
        await SetFilteredCardsAsync();
    }

    private async Task SetFilteredCardsAsync()
    {
        filteredCards = state.Cards.Values.Where(c =>
        {
            if (!string.IsNullOrEmpty(expansionFilter))
            {
                return c.ExpansionCode == expansionFilter;
            }
            else if (!string.IsNullOrEmpty(digitalReleaseFilter))
            {
                return c.DigitalReleaseSet == digitalReleaseFilter;
            }
            else
            {
                return true;
            }
        }).ToImmutableArray();

        if (CardInfoContainer != null)
        {
            await CardInfoContainer.RefreshDataAsync();
        }
        StateHasChanged();
    }

    private ValueTask<ItemsProviderResult<CardInfo>> ProvideFilteredCards(ItemsProviderRequest request)
    {
        var numCards = Math.Min(request.Count, filteredCards.Length - request.StartIndex);
        var result = filteredCards.Skip(request.StartIndex).Take(numCards);
        return ValueTask.FromResult(new ItemsProviderResult<CardInfo>(result, filteredCards.Length));
    }
}


