<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Amsel.Avalonia.ViewModels"
        xmlns:local="using:Amsel.Avalonia.Views.ContentPages"
        x:Class="Amsel.Avalonia.Views.Windows.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Amsel.Avalonia">

    <Panel>
        <TabControl SelectedIndex="{Binding ActiveTabIndex}" IsVisible="{Binding Ready}">
            <TabItem Header="Set statistics">
                <local:SetStatistics DataContext="{Binding SetStatisticViewModel}" />
            </TabItem>
            <TabItem Header="Card list">
                <local:CardList DataContext="{Binding CardListViewModel}" />
            </TabItem>
        </TabControl>
        <TextBlock Text="Loading..."
                   IsVisible="{Binding !Ready}"
                   FontSize="32"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
    </Panel>

</Window>
