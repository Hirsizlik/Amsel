<UserControl xmlns="https://github.com/avaloniaui" 
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Amsel.Avalonia.Views.SetStatisticTile"
             x:Name="root">
    <StackPanel>
        <Panel Width="80">
            <Image Source="{Binding #root.SetInformation.CommonSymbol, Mode=OneWay}" Height="32" ></Image>
        </Panel>
        <StackPanel>
            <TextBlock Text="{Binding #root.SetInformation.Set.Code, Mode=OneWay}" />
            <TextBlock Text="{Binding #root.SetInformation.Set.Name, Mode=OneWay}" />
        </StackPanel>
    </StackPanel>
</UserControl>
