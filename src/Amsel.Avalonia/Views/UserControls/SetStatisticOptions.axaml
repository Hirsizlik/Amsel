<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Amsel.Avalonia.Views.UserControls"
             xmlns:c="using:Amsel.Avalonia.Converters"
             x:Class="Amsel.Avalonia.Views.UserControls.SetStatisticOptions"
             x:Name="root">
    <UserControl.Resources>
        <ResourceDictionary>
            <c:EnumDescriptionConverter x:Key="EnumConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <ComboBox x:DataType="v:Sort" ItemsSource="{Binding #root.Sorts}"
                      SelectedValue="{Binding #root.Sort}"
                      SelectionChanged="OnSortChanged" >
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EnumConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox x:DataType="v:Direction" ItemsSource="{Binding #root.Directions}"
                      SelectedValue="{Binding #root.Direction}"
                      SelectionChanged="OnDirectionChanged" >
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EnumConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        <CheckBox IsChecked="{Binding #root.WithoutMetadata}"
                  IsCheckedChanged="OnWithoutMetadataChanged">
            Include sets without metadata
        </CheckBox>
        <CheckBox IsChecked="{Binding #root.WithoutName}"
                  IsEnabled="{Binding #root.WithoutMetadata}"
                  IsCheckedChanged="OnWithoutNameChanged">
            Include sets without name
        </CheckBox>
        <CheckBox IsChecked="{Binding #root.WithoutProgress}"
                  IsCheckedChanged="OnWithoutProgressChanged">
            Include sets without progress
        </CheckBox>
        <CheckBox IsChecked="{Binding #root.WithSubsets}"
                  IsCheckedChanged="OnWithSubsetsChanged">
            Include subsets
        </CheckBox>
    </StackPanel>
</UserControl>
