<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Amsel.Avalonia.Views.UserControls"
             xmlns:models="using:Amsel.Avalonia.Models"
             xmlns:vm="using:Amsel.Avalonia.ViewModels"
             x:Class="Amsel.Avalonia.Views.ContentPages.CardList"
             x:DataType="vm:CardListViewModel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="32"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>
        <ComboBox ItemsSource="{Binding Sets, Mode=OneWay}" Grid.Row="0" Grid.ColumnSpan="2"
                  SelectedItem="{Binding SetWithSymbol}"
                  HorizontalAlignment="Stretch"
                  Height="50">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:DecoratedSetInformation">
                    <local:SetEntryElement SetName="{Binding Set.Name}"
                                           Code="{Binding Set.Code}"
                                           Symbol="{Binding CommonSymbol}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <Grid.Styles>
            <Style Selector="TextBox.error">
                <Setter Property="Foreground">#FF0000</Setter>
            </Style>
        </Grid.Styles>
        <TextBox Text="{Binding Search}"
                 Grid.Row="1" Grid.Column="0"
                 KeyUp="OnSearchKeyUp"
                 Classes.error="{Binding SearchError}"
                 PlaceholderText="Search..." />
        <Button Grid.Row="1" Grid.Column="1" Content="?" Click="OnSearchHelpClicked" />

        <TableView ItemsSource="{Binding Cards, Mode=OneWay}" Grid.Row="3" Grid.ColumnSpan="2">
            <TableView.Styles>
                <Style Selector="TextBlock.noncollectible">
                    <Setter Property="Foreground">#AAAAAA</Setter>
                </Style>
            </TableView.Styles>
            <TableView.Columns>
                <TableViewColumn Header="Name"
                                 x:DataType="models:DecoratedCardStats">
                    <TableViewColumn.CellTemplate>
                        <DataTemplate x:DataType="models:DecoratedCardStats">
                            <TextBlock Text="{Binding CardStats.Info.Name}"
                                       Classes.noncollectible="{Binding !CardStats.Collectible}" />
                        </DataTemplate>
                    </TableViewColumn.CellTemplate>
                </TableViewColumn>
                <TableViewColumn Header="Set" >
                    <TableViewColumn.CellTemplate>
                        <DataTemplate x:DataType="models:DecoratedCardStats">
                            <local:SetEntryElement SetName="{Binding SetName}"
                                                   Code="{Binding CardStats.Info.ExpansionCode}"
                                                   Symbol="{Binding SetSymbol}" />
                        </DataTemplate>
                    </TableViewColumn.CellTemplate>
                </TableViewColumn>
                <TableViewColumn Header="Digital Set" >
                    <TableViewColumn.CellTemplate>
                        <DataTemplate x:DataType="models:DecoratedCardStats">
                            <local:SetEntryElement SetName="{Binding DigitalSetName}"
                                                   Code="{Binding CardStats.Info.DigitalReleaseSet}"
                                                   Symbol="{Binding DigitalSetSymbol}" />
                        </DataTemplate>
                    </TableViewColumn.CellTemplate>
                </TableViewColumn>
                <TableViewColumn Header="Rarity"
                                 x:DataType="models:DecoratedCardStats"
                                 Binding="{Binding RarityCode }"
                                 Width="60" />
                <TableViewColumn x:DataType="models:DecoratedCardStats"
                                 Width="80">
                    <TableViewColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="Owned" />
                                <TextBlock Text="(this set)" />
                            </StackPanel>
                        </DataTemplate>
                    </TableViewColumn.HeaderTemplate>
                    <TableViewColumn.CellTemplate>
                        <DataTemplate x:DataType="models:DecoratedCardStats">
                            <TextBlock Text="{Binding CardStats.Owned }"
                                       Classes.noncollectible="{Binding !CardStats.Collectible}" />
                        </DataTemplate>
                    </TableViewColumn.CellTemplate>
                </TableViewColumn>
                <TableViewColumn x:DataType="models:DecoratedCardStats"
                                 Binding="{Binding OwnedOverall }"
                                 Width="80">
                    <TableViewColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="Owned" />
                                <TextBlock Text="(overall)" />
                            </StackPanel>
                        </DataTemplate>
                    </TableViewColumn.HeaderTemplate>
                </TableViewColumn>
                <TableViewColumn Header="Format legalities">
                    <TableViewColumn.CellTemplate>
                        <DataTemplate x:DataType="models:DecoratedCardStats">
                            <local:FormatLegalityList FormatLegalities="{Binding FormatLegalities}" />
                        </DataTemplate>
                    </TableViewColumn.CellTemplate>
                </TableViewColumn>
            </TableView.Columns>
        </TableView>
    </Grid>
</ContentPage>
