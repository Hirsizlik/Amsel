<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Amsel.Avalonia.Models"
             xmlns:v="using:Amsel.Avalonia.Views.UserControls"
             xmlns:vm="using:Amsel.Avalonia.ViewModels"
             x:Class="Amsel.Avalonia.Views.ContentPages.SetStatistics"
             x:DataType="vm:SetStatisticViewModel">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <v:SetStatisticOptions Grid.Column="0"
                               OptionsChanged="OnSetStatisticOptionsChanged"
                               Sort="ReleaseDate"
                               Direction="Descending"
                               WithSubsets="True" />
        <ScrollViewer Grid.Column="1">
            <ListBox ItemsSource="{Binding Sets}" SelectionChanged="OnSelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="240" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="m:DecoratedSetInformation">
                        <v:SetStatisticTile SetInformation="{Binding}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
        <v:SetStatisticDetails Grid.Column="2" SetInformation="{Binding SelectedSet}" IsVisible="{Binding !!SelectedSet}" />
    </Grid>

</ContentPage>
