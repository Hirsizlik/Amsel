<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Amsel.Avalonia.Models"
             xmlns:v="using:Amsel.Avalonia.Views"
             xmlns:vm="using:Amsel.Avalonia.ViewModels"
             x:Class="Amsel.Avalonia.Views.SetStatistics"
             x:DataType="vm:SetStatisticViewModel">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <v:SetStatisticOptions Grid.Column="0" />
        <ScrollViewer Grid.Column="1">
            <ItemsControl ItemsSource="{Binding Sets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemSpacing="15" LineSpacing="15" ItemWidth="220" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:DecoratedSetInformation">
                        <v:SetStatisticTile SetInformation="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

</ContentPage>
