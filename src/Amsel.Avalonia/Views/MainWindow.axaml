<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Amsel.Avalonia.ViewModels"
        xmlns:local="using:Amsel.Avalonia.Views"
        x:Class="Amsel.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Amsel.Avalonia">

    <TabControl SelectedIndex="{Binding ActiveTabIndex}">
        <TabItem Header="Set statistics">
            <local:SetStatistics />
        </TabItem>
        <TabItem Header="Card list" DataContext="{Binding CardListViewModel}">
            <local:CardList />
        </TabItem>
    </TabControl>

</Window>
